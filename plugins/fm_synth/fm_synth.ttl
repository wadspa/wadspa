@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .

<https://wadspa.org/plugins/fm_synth>
    a lv2:InstrumentPlugin, lv2:Plugin ;
    doap:name "FM Synth" ;
    doap:description "2-operator FM synthesizer, 8-voice polyphonic. Op2 (modulator) feeds Op1 (carrier)." ;

    lv2:requiredFeature urid:map ;
    lv2:optionalFeature lv2:hardRTCapable ;

    lv2:port [
        a lv2:InputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        lv2:index 0 ;
        lv2:symbol "midi_in" ;
        lv2:name "MIDI In" ;
    ] , [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "out_l" ;
        lv2:name "Audio Out L" ;
    ] , [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 2 ;
        lv2:symbol "out_r" ;
        lv2:name "Audio Out R" ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 3 ;
        lv2:symbol "mod_ratio" ;
        lv2:name "Mod Ratio" ;
        lv2:minimum 0.5 ;
        lv2:maximum 8.0 ;
        lv2:default 2.0 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 4 ;
        lv2:symbol "mod_index" ;
        lv2:name "Mod Index" ;
        lv2:minimum 0.0 ;
        lv2:maximum 10.0 ;
        lv2:default 3.0 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "mod_decay" ;
        lv2:name "Mod Decay" ;
        lv2:minimum 0.01 ;
        lv2:maximum 4.0 ;
        lv2:default 0.5 ;
        units:unit units:s ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "attack" ;
        lv2:name "Attack" ;
        lv2:minimum 0.001 ;
        lv2:maximum 4.0 ;
        lv2:default 0.01 ;
        units:unit units:s ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "decay" ;
        lv2:name "Decay" ;
        lv2:minimum 0.001 ;
        lv2:maximum 4.0 ;
        lv2:default 0.3 ;
        units:unit units:s ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "sustain" ;
        lv2:name "Sustain" ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:default 0.5 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "release" ;
        lv2:name "Release" ;
        lv2:minimum 0.001 ;
        lv2:maximum 8.0 ;
        lv2:default 0.5 ;
        units:unit units:s ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "gain" ;
        lv2:name "Gain" ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:default 0.7 ;
    ] .

@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .

<urn:zamaudio:ZamEcho>
    a lv2:Plugin ;
    lv2:binary <ZamEcho.wasm> ;
    rdfs:seeAlso <ZamEcho.ttl> .

    a ui:CocoaUI ;
    ui:binary <ZamEcho_ui.wasm> ;
    rdfs:seeAlso <ZamEcho_ui.ttl> .

    a pset:Preset ;
    lv2:appliesTo <urn:zamaudio:ZamEcho> ;
    rdfs:label "Zero" ;
    rdfs:seeAlso <presets.ttl> .

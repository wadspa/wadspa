@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .

<urn:zamaudio:ZamDynamicEQ>
    a lv2:Plugin ;
    lv2:binary <ZamDynamicEQ.wasm> ;
    rdfs:seeAlso <ZamDynamicEQ.ttl> .

    a ui:CocoaUI ;
    ui:binary <ZamDynamicEQ_ui.wasm> ;
    rdfs:seeAlso <ZamDynamicEQ_ui.ttl> .

    a pset:Preset ;
    lv2:appliesTo <urn:zamaudio:ZamDynamicEQ> ;
    rdfs:label "Zero" ;
    rdfs:seeAlso <presets.ttl> .

    a pset:Preset ;
    lv2:appliesTo <urn:zamaudio:ZamDynamicEQ> ;
    rdfs:label "PoppySnare" ;
    rdfs:seeAlso <presets.ttl> .

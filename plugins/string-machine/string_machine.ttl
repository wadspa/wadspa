@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .
@prefix opts:  <http://lv2plug.in/ns/ext/options#> .
@prefix pg:    <http://lv2plug.in/ns/ext/port-groups#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rsz:   <http://lv2plug.in/ns/ext/resize-port#> .
@prefix spdx:  <http://spdx.org/rdf/terms#> .
@prefix ui:    <http://lv2plug.in/ns/extensions/ui#> .
@prefix unit:  <http://lv2plug.in/ns/extensions/units#> .

<http://jpcima.sdf1.org/lv2/string-machine-mk2>
    a lv2:InstrumentPlugin, lv2:Plugin, doap:Project ;

    lv2:extensionData opts:interface ,
                      <http://kxstudio.sf.net/ns/lv2ext/programs#Interface> ;

    lv2:optionalFeature <http://lv2plug.in/ns/lv2core#hardRTCapable> ,
                        <http://lv2plug.in/ns/ext/buf-size#boundedBlockLength> ;

    lv2:requiredFeature opts:options ,
                        <http://lv2plug.in/ns/ext/urid#map> ;

    opts:supportedOption <http://lv2plug.in/ns/ext/buf-size#nominalBlockLength> ,
                         <http://lv2plug.in/ns/ext/buf-size#maxBlockLength> ,
                         <http://lv2plug.in/ns/ext/parameters#sampleRate> ;


    lv2:port [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 0 ;
        lv2:symbol "lv2_audio_out_1" ;
        lv2:name "Audio Output 1" ;
    ] ,
    [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "lv2_audio_out_2" ;
        lv2:name "Audio Output 2" ;
    ] ;

    lv2:port [
        a lv2:InputPort, atom:AtomPort ;
        lv2:index 2 ;
        lv2:name "Events Input" ;
        lv2:symbol "lv2_events_in" ;
        rsz:minimumSize 2048 ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
    ] ;

    lv2:port [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 3 ;
        lv2:name "Oscillator detune" ;
        lv2:symbol "osc_detune" ;
        lv2:default 0.00159999995958 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 4 ;
        lv2:name "Oscillator HP Cutoff 4'" ;
        lv2:symbol "osc_hp_cutoff_upper" ;
        lv2:default 8 ;
        lv2:minimum -20 ;
        lv2:maximum 60 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ;
        lv2:name "Oscillator HP Cutoff 8'" ;
        lv2:symbol "osc_hp_cutoff_lower" ;
        lv2:default 8 ;
        lv2:minimum -20 ;
        lv2:maximum 60 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ;
        lv2:name "Oscillator PWM Depth" ;
        lv2:symbol "osc_pwm_depth" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 100 ;
        unit:unit unit:pc ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 7 ;
        lv2:name "Oscillator PWM Frequency" ;
        lv2:symbol "osc_pwm_frequency" ;
        lv2:default 0.25 ;
        lv2:minimum 0.10000000149 ;
        lv2:maximum 5 ;
        unit:unit unit:hz ;
        lv2:portProperty <http://lv2plug.in/ns/ext/port-props#logarithmic> ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 8 ;
        lv2:name "Oscillator enhance 4'" ;
        lv2:symbol "osc_enhance_upper" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 0.5 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 9 ;
        lv2:name "Oscillator enhance 8'" ;
        lv2:symbol "osc_enhance_lower" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 0.5 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 10 ;
        lv2:name "Filters LP Cutoff 4'" ;
        lv2:symbol "flt_lp_cutoff_upper" ;
        lv2:default 5.19999980927 ;
        lv2:minimum -20 ;
        lv2:maximum 120 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 11 ;
        lv2:name "Filters HP Cutoff 4'" ;
        lv2:symbol "flt_hp_cutoff_upper" ;
        lv2:default 12.1999998093 ;
        lv2:minimum -20 ;
        lv2:maximum 120 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 12 ;
        lv2:name "Filters LP Cutoff 8'" ;
        lv2:symbol "flt_lp_cutoff_lower" ;
        lv2:default 16.3999996185 ;
        lv2:minimum -20 ;
        lv2:maximum 120 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 13 ;
        lv2:name "Filters HP Cutoff 8'" ;
        lv2:symbol "flt_hp_cutoff_lower" ;
        lv2:default -0.40000000596 ;
        lv2:minimum -20 ;
        lv2:maximum 120 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 14 ;
        lv2:name "Filters HS Cutoff 4'" ;
        lv2:symbol "flt_hs_cutoff_eq" ;
        lv2:default 24.7999992371 ;
        lv2:minimum -20 ;
        lv2:maximum 120 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 15 ;
        lv2:name "Filters HS Boost 4'" ;
        lv2:symbol "flt_hs_boost_eq" ;
        lv2:default 6 ;
        lv2:minimum -20 ;
        lv2:maximum 20 ;
        unit:unit unit:db ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 16 ;
        lv2:name "Mix Gain 4'" ;
        lv2:symbol "mix_gain_upper" ;
        lv2:default 0 ;
        lv2:minimum -20 ;
        lv2:maximum 0 ;
        unit:unit unit:db ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 17 ;
        lv2:name "Mix Gain 8'" ;
        lv2:symbol "mix_gain_lower" ;
        lv2:default 0 ;
        lv2:minimum -20 ;
        lv2:maximum 0 ;
        unit:unit unit:db ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 18 ;
        lv2:name "Envelope attack" ;
        lv2:symbol "env_attack" ;
        lv2:default 0.193900004029 ;
        lv2:minimum 0.00999999977648 ;
        lv2:maximum 10 ;
        unit:unit unit:s ;
        lv2:portProperty <http://lv2plug.in/ns/ext/port-props#logarithmic> ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 19 ;
        lv2:name "Envelope hold" ;
        lv2:symbol "env_hold" ;
        lv2:default 0.00999999977648 ;
        lv2:minimum 0.00999999977648 ;
        lv2:maximum 10 ;
        unit:unit unit:s ;
        lv2:portProperty <http://lv2plug.in/ns/ext/port-props#logarithmic> ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 20 ;
        lv2:name "Envelope decay" ;
        lv2:symbol "env_decay" ;
        lv2:default 10 ;
        lv2:minimum 0.00999999977648 ;
        lv2:maximum 10 ;
        unit:unit unit:s ;
        lv2:portProperty <http://lv2plug.in/ns/ext/port-props#logarithmic> ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 21 ;
        lv2:name "Envelope sustain" ;
        lv2:symbol "env_sustain" ;
        lv2:default 0 ;
        lv2:minimum -60 ;
        lv2:maximum 0 ;
        unit:unit unit:db ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 22 ;
        lv2:name "Envelope release" ;
        lv2:symbol "env_release" ;
        lv2:default 3 ;
        lv2:minimum 0.00999999977648 ;
        lv2:maximum 10 ;
        unit:unit unit:s ;
        lv2:portProperty <http://lv2plug.in/ns/ext/port-props#logarithmic> ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 23 ;
        lv2:name "Chorus enabled" ;
        lv2:symbol "cho_enabled" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
        lv2:portProperty lv2:integer ;
        lv2:portProperty <http://lv2plug.in/ns/ext/port-props#expensive> ,
                         <http://kxstudio.sf.net/ns/lv2ext/props#NonAutomatable> ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 24 ;
        lv2:name "Chorus global depth" ;
        lv2:symbol "cho_depth" ;
        lv2:default 100 ;
        lv2:minimum 0 ;
        lv2:maximum 100 ;
        unit:unit unit:pc ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 25 ;
        lv2:name "Chorus rate 1" ;
        lv2:symbol "cho_rate1" ;
        lv2:default 5.83459997177 ;
        lv2:minimum 1 ;
        lv2:maximum 9 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 26 ;
        lv2:name "Chorus depth 1" ;
        lv2:symbol "cho_depth1" ;
        lv2:default 30.7099990845 ;
        lv2:minimum 0 ;
        lv2:maximum 100 ;
        unit:unit unit:pc ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 27 ;
        lv2:name "Chorus rate 2" ;
        lv2:symbol "cho_rate2" ;
        lv2:default 0.583500027657 ;
        lv2:minimum 0.10000000149 ;
        lv2:maximum 0.899999976158 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 28 ;
        lv2:name "Chorus depth 2" ;
        lv2:symbol "cho_depth2" ;
        lv2:default 90.5500030518 ;
        lv2:minimum 0 ;
        lv2:maximum 100 ;
        unit:unit unit:pc ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 29 ;
        lv2:name "Chorus model" ;
        lv2:symbol "cho_model" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:enumeration ;
        lv2:scalePoint [
            rdfs:label  "Digital delay" ;
            rdf:value 0 ;
        ] ,
        [
            rdfs:label  "Analog bucket-brigade delay" ;
            rdf:value 1 ;
        ] ;
        lv2:portProperty lv2:integer ;
        lv2:portProperty <http://lv2plug.in/ns/ext/port-props#expensive> ,
                         <http://kxstudio.sf.net/ns/lv2ext/props#NonAutomatable> ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 30 ;
        lv2:name "Master Gain" ;
        lv2:symbol "master_gain" ;
        lv2:default 3 ;
        lv2:minimum -60 ;
        lv2:maximum 20 ;
        unit:unit unit:db ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 31 ;
        lv2:name "Polyphony" ;
        lv2:symbol "polyphony" ;
        lv2:default 16 ;
        lv2:minimum 1 ;
        lv2:maximum 32 ;
        lv2:portProperty lv2:integer ;
    ] ,
    [
        a lv2:OutputPort, lv2:ControlPort ;
        lv2:index 32 ;
        lv2:name "Oscillator detune 4'" ;
        lv2:symbol "osc_current_detune_upper" ;
        lv2:minimum -1 ;
        lv2:maximum 1 ;
    ] ,
    [
        a lv2:OutputPort, lv2:ControlPort ;
        lv2:index 33 ;
        lv2:name "Oscillator detune 8'" ;
        lv2:symbol "osc_current_detune_lower" ;
        lv2:minimum -1 ;
        lv2:maximum 1 ;
    ] ,
    [
        a lv2:OutputPort, lv2:ControlPort ;
        lv2:index 34 ;
        lv2:name "Chorus phase 1" ;
        lv2:symbol "cho_current_phase1" ;
        lv2:minimum 0 ;
        lv2:maximum 6.28318548203 ;
        unit:unit [
            a unit:Unit ;
            rdfs:label  "rad" ;
            unit:symbol "rad" ;
            unit:render "%f rad" ;
        ] ;
    ] ,
    [
        a lv2:OutputPort, lv2:ControlPort ;
        lv2:index 35 ;
        lv2:name "Chorus phase 2" ;
        lv2:symbol "cho_current_phase2" ;
        lv2:minimum 0 ;
        lv2:maximum 6.28318548203 ;
        unit:unit [
            a unit:Unit ;
            rdfs:label  "rad" ;
            unit:symbol "rad" ;
            unit:render "%f rad" ;
        ] ;
    ] ,
    [
        a lv2:OutputPort, lv2:ControlPort ;
        lv2:index 36 ;
        lv2:name "Master level 1" ;
        lv2:symbol "master_current_level1" ;
        lv2:minimum -100 ;
        lv2:maximum 100 ;
        unit:unit unit:db ;
    ] ,
    [
        a lv2:OutputPort, lv2:ControlPort ;
        lv2:index 37 ;
        lv2:name "Master level 2" ;
        lv2:symbol "master_current_level2" ;
        lv2:minimum -100 ;
        lv2:maximum 100 ;
        unit:unit unit:db ;
    ] ;

    rdfs:comment "Emulation of an electronic string ensemble synthesizer" ;

    mod:brand "Jean Pierre Cimalando" ;
    mod:label "String machine" ;

    doap:name "String machine" ;
    doap:license <http://spdx.org/licenses/GPL-2.0-or-later> ;

    doap:maintainer [
        foaf:name "Jean Pierre Cimalando" ;
        foaf:homepage <https://github.com/jpcima/string-machine> ;
    ] ;

    lv2:microVersion 0 ;
    lv2:minorVersion 0 .


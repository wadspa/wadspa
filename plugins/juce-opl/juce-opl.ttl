@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix pprop: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .

<https://github.com/jpcima/JuceOPL#instrument>
    a lv2:InstrumentPlugin, lv2:Plugin ;
    doap:name "JuceOPL" ;
    doap:description "AdLib/Sound Blaster OPL2 chip synthesizer" ;
    lv2:requiredFeature urid:map ;
    lv2:optionalFeature lv2:hardRTCapable ;

    lv2:port [
        a lv2:InputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        lv2:index 0 ;
        lv2:symbol "midi_in" ;
        lv2:name "MIDI In" ;
    ] , [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "out_l" ;
        lv2:name "Audio Out L" ;
    ] , [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 2 ;
        lv2:symbol "out_r" ;
        lv2:name "Audio Out R" ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 3 ;
        lv2:symbol "carrier_wave" ;
        lv2:name "Carrier Wave" ;
        lv2:minimum 0 ;
        lv2:maximum 7 ;
        lv2:default 0 ;
        lv2:portProperty pprop:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 4 ;
        lv2:symbol "modulator_wave" ;
        lv2:name "Modulator Wave" ;
        lv2:minimum 0 ;
        lv2:maximum 7 ;
        lv2:default 2 ;
        lv2:portProperty pprop:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "carrier_multiplier" ;
        lv2:name "Carrier Frequency Multiplier" ;
        lv2:minimum 0 ;
        lv2:maximum 15 ;
        lv2:default 1 ;
        lv2:portProperty pprop:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "modulator_multiplier" ;
        lv2:name "Modulator Frequency Multiplier" ;
        lv2:minimum 0 ;
        lv2:maximum 15 ;
        lv2:default 2 ;
        lv2:portProperty pprop:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "carrier_attenuation" ;
        lv2:name "Carrier Attenuation" ;
        lv2:minimum 0 ;
        lv2:maximum 63 ;
        lv2:default 9 ;
        lv2:portProperty pprop:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "modulator_attenuation" ;
        lv2:name "Modulator Attenuation" ;
        lv2:minimum 0 ;
        lv2:maximum 63 ;
        lv2:default 26 ;
        lv2:portProperty pprop:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "carrier_tremolo" ;
        lv2:name "Carrier Tremolo" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0 ;
        lv2:portProperty pprop:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "carrier_vibrato" ;
        lv2:name "Carrier Vibrato" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0 ;
        lv2:portProperty pprop:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "modulator_tremolo" ;
        lv2:name "Modulator Tremolo" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0 ;
        lv2:portProperty pprop:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 12 ;
        lv2:symbol "modulator_vibrato" ;
        lv2:name "Modulator Vibrato" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0 ;
        lv2:portProperty pprop:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 13 ;
        lv2:symbol "carrier_keyscale_level" ;
        lv2:name "Carrier Keyscale Level" ;
        lv2:minimum 0 ;
        lv2:maximum 3 ;
        lv2:default 0 ;
        lv2:portProperty pprop:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 14 ;
        lv2:symbol "modulator_keyscale_level" ;
        lv2:name "Modulator Keyscale Level" ;
        lv2:minimum 0 ;
        lv2:maximum 3 ;
        lv2:default 0 ;
        lv2:portProperty pprop:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 15 ;
        lv2:symbol "algorithm" ;
        lv2:name "Algorithm" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0 ;
        lv2:portProperty pprop:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 16 ;
        lv2:symbol "modulator_feedback" ;
        lv2:name "Modulator Feedback" ;
        lv2:minimum 0 ;
        lv2:maximum 7 ;
        lv2:default 0 ;
        lv2:portProperty pprop:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 17 ;
        lv2:symbol "carrier_attack" ;
        lv2:name "Carrier Attack" ;
        lv2:minimum 0 ;
        lv2:maximum 15 ;
        lv2:default 8 ;
        lv2:portProperty pprop:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 18 ;
        lv2:symbol "modulator_attack" ;
        lv2:name "Modulator Attack" ;
        lv2:minimum 0 ;
        lv2:maximum 15 ;
        lv2:default 8 ;
        lv2:portProperty pprop:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 19 ;
        lv2:symbol "carrier_velocity_sensitivity" ;
        lv2:name "Carrier Velocity Sensitivity" ;
        lv2:minimum 0 ;
        lv2:maximum 2 ;
        lv2:default 0 ;
        lv2:portProperty pprop:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 20 ;
        lv2:symbol "modulator_velocity_sensitivity" ;
        lv2:name "Modulator Velocity Sensitivity" ;
        lv2:minimum 0 ;
        lv2:maximum 2 ;
        lv2:default 0 ;
        lv2:portProperty pprop:integer ;
    ] .

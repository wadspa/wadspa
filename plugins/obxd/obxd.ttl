@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix pprop: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .

<http://distrho.sf.net/plugins/obxd>
    a lv2:InstrumentPlugin, lv2:Plugin ;
    doap:name "Obxd" ;
    doap:description "Oberheim OB-X style virtual analog synthesizer" ;
    lv2:requiredFeature urid:map ;
    lv2:optionalFeature lv2:hardRTCapable ;

    lv2:port [
        a lv2:InputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        lv2:index 0 ;
        lv2:symbol "midi_in" ;
        lv2:name "MIDI In" ;
    ] , [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "out_l" ;
        lv2:name "Audio Out L" ;
    ] , [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 2 ;
        lv2:symbol "out_r" ;
        lv2:name "Audio Out R" ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 3 ;
        lv2:symbol "volume" ;
        lv2:name "Volume" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0.65 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 4 ;
        lv2:symbol "voice_count" ;
        lv2:name "Voice Count" ;
        lv2:minimum 1 ;
        lv2:maximum 8 ;
        lv2:default 8 ;
        lv2:portProperty pprop:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "tune" ;
        lv2:name "Tune" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0.5 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "octave" ;
        lv2:name "Octave" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0.5 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "unison" ;
        lv2:name "Unison" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0 ;
        lv2:portProperty pprop:integer , pprop:toggled ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "voice_detune" ;
        lv2:name "Voice Detune" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0.2 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "osc2_detune" ;
        lv2:name "Oscillator 2 Detune" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0.4 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "osc1_mix" ;
        lv2:name "Oscillator 1 Mix" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 1 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "osc2_mix" ;
        lv2:name "Oscillator 2 Mix" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 1 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 12 ;
        lv2:symbol "noise_mix" ;
        lv2:name "Noise Mix" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 13 ;
        lv2:symbol "osc1_saw" ;
        lv2:name "Oscillator 1 Saw" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 1 ;
        lv2:portProperty pprop:integer , pprop:toggled ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 14 ;
        lv2:symbol "osc1_pulse" ;
        lv2:name "Oscillator 1 Pulse" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 1 ;
        lv2:portProperty pprop:integer , pprop:toggled ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 15 ;
        lv2:symbol "osc2_saw" ;
        lv2:name "Oscillator 2 Saw" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 1 ;
        lv2:portProperty pprop:integer , pprop:toggled ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 16 ;
        lv2:symbol "osc2_pulse" ;
        lv2:name "Oscillator 2 Pulse" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 1 ;
        lv2:portProperty pprop:integer , pprop:toggled ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 17 ;
        lv2:symbol "pulse_width" ;
        lv2:name "Pulse Width" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0.5 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 18 ;
        lv2:symbol "cutoff" ;
        lv2:name "Filter Cutoff" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0.7 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 19 ;
        lv2:symbol "brightness" ;
        lv2:name "Brightness" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 1 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 20 ;
        lv2:symbol "resonance" ;
        lv2:name "Filter Resonance" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0.22 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 21 ;
        lv2:symbol "filter_env_amount" ;
        lv2:name "Filter Envelope Amount" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0.35 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 22 ;
        lv2:symbol "filter_mode" ;
        lv2:name "Filter Morph" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0.5 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 23 ;
        lv2:symbol "bandpass_blend" ;
        lv2:name "Bandpass Blend" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0 ;
        lv2:portProperty pprop:integer , pprop:toggled ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 24 ;
        lv2:symbol "four_pole" ;
        lv2:name "Four Pole Slope" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0 ;
        lv2:portProperty pprop:integer , pprop:toggled ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 25 ;
        lv2:symbol "amp_attack" ;
        lv2:name "Amp Attack" ;
        lv2:minimum 0 ;
        lv2:maximum 0.65 ;
        lv2:default 0.05 ;
        lv2:portProperty pprop:logarithmic ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 26 ;
        lv2:symbol "amp_decay" ;
        lv2:name "Amp Decay" ;
        lv2:minimum 0 ;
        lv2:maximum 0.65 ;
        lv2:default 0.18 ;
        lv2:portProperty pprop:logarithmic ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 27 ;
        lv2:symbol "amp_sustain" ;
        lv2:name "Amp Sustain" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0.75 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 28 ;
        lv2:symbol "amp_release" ;
        lv2:name "Amp Release" ;
        lv2:minimum 0 ;
        lv2:maximum 0.65 ;
        lv2:default 0.18 ;
        lv2:portProperty pprop:logarithmic ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 29 ;
        lv2:symbol "filter_attack" ;
        lv2:name "Filter Attack" ;
        lv2:minimum 0 ;
        lv2:maximum 0.65 ;
        lv2:default 0.03 ;
        lv2:portProperty pprop:logarithmic ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 30 ;
        lv2:symbol "filter_decay" ;
        lv2:name "Filter Decay" ;
        lv2:minimum 0 ;
        lv2:maximum 0.65 ;
        lv2:default 0.22 ;
        lv2:portProperty pprop:logarithmic ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 31 ;
        lv2:symbol "filter_sustain" ;
        lv2:name "Filter Sustain" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0.35 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 32 ;
        lv2:symbol "filter_release" ;
        lv2:name "Filter Release" ;
        lv2:minimum 0 ;
        lv2:maximum 0.65 ;
        lv2:default 0.18 ;
        lv2:portProperty pprop:logarithmic ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 33 ;
        lv2:symbol "lfo_frequency" ;
        lv2:name "LFO Frequency" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0.35 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 34 ;
        lv2:symbol "lfo_pitch_amount" ;
        lv2:name "LFO Pitch Amount" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0.12 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 35 ;
        lv2:symbol "lfo_sine" ;
        lv2:name "LFO Sine Wave" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 1 ;
        lv2:portProperty pprop:integer , pprop:toggled ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 36 ;
        lv2:symbol "lfo_square" ;
        lv2:name "LFO Square Wave" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0 ;
        lv2:portProperty pprop:integer , pprop:toggled ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 37 ;
        lv2:symbol "lfo_sample_hold" ;
        lv2:name "LFO Sample Hold Wave" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0 ;
        lv2:portProperty pprop:integer , pprop:toggled ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 38 ;
        lv2:symbol "lfo_osc1" ;
        lv2:name "LFO Oscillator 1" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 1 ;
        lv2:portProperty pprop:integer , pprop:toggled ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 39 ;
        lv2:symbol "lfo_osc2" ;
        lv2:name "LFO Oscillator 2" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0 ;
        lv2:portProperty pprop:integer , pprop:toggled ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 40 ;
        lv2:symbol "lfo_filter" ;
        lv2:name "LFO Filter" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0 ;
        lv2:portProperty pprop:integer , pprop:toggled ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 41 ;
        lv2:symbol "xmod" ;
        lv2:name "Oscillator Cross Mod" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 42 ;
        lv2:symbol "osc2_hard_sync" ;
        lv2:name "Oscillator 2 Hard Sync" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0 ;
        lv2:portProperty pprop:integer , pprop:toggled ;
    ] .

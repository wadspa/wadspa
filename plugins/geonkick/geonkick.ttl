@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix pprop: <http://lv2plug.in/ns/ext/port-props#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .

<https://wadspa.org/plugins/geonkick>
    a lv2:InstrumentPlugin, lv2:Plugin ;
    doap:name "Geonkick" ;
    doap:description "Browser LV2 port of the Geonkick C DSP core as a MIDI-triggered kick drum synthesizer" ;

    lv2:requiredFeature urid:map ;
    lv2:optionalFeature lv2:hardRTCapable ;

    lv2:port [
        a lv2:InputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        lv2:index 0 ;
        lv2:symbol "midi_in" ;
        lv2:name "MIDI In" ;
    ] , [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "out_l" ;
        lv2:name "Audio Out L" ;
    ] , [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 2 ;
        lv2:symbol "out_r" ;
        lv2:name "Audio Out R" ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 3 ;
        lv2:symbol "frequency" ;
        lv2:name "Bass Frequency" ;
        lv2:minimum 30.0 ;
        lv2:maximum 220.0 ;
        lv2:default 55.0 ;
        lv2:portProperty pprop:logarithmic ;
        units:unit units:hz ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 4 ;
        lv2:symbol "decay" ;
        lv2:name "Decay" ;
        lv2:minimum 0.08 ;
        lv2:maximum 1.5 ;
        lv2:default 0.52 ;
        lv2:portProperty pprop:logarithmic ;
        units:unit units:s ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "pitch_drop" ;
        lv2:name "Pitch Drop" ;
        lv2:minimum 0.0 ;
        lv2:maximum 48.0 ;
        lv2:default 18.0 ;
        units:unit units:semitone12TET ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "noise" ;
        lv2:name "Noise Amount" ;
        lv2:minimum 0.0 ;
        lv2:maximum 0.85 ;
        lv2:default 0.06 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "click" ;
        lv2:name "Click Amount" ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:default 0.35 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "tone" ;
        lv2:name "Tone Cutoff" ;
        lv2:minimum 120.0 ;
        lv2:maximum 8000.0 ;
        lv2:default 3600.0 ;
        lv2:portProperty pprop:logarithmic ;
        units:unit units:hz ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "resonance" ;
        lv2:name "Resonance" ;
        lv2:minimum 0.5 ;
        lv2:maximum 4.0 ;
        lv2:default 0.8 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "drive" ;
        lv2:name "Drive" ;
        lv2:minimum 1.0 ;
        lv2:maximum 6.0 ;
        lv2:default 1.0 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "gain" ;
        lv2:name "Gain" ;
        lv2:minimum 0.08 ;
        lv2:maximum 0.9 ;
        lv2:default 0.58 ;
    ] .

#include "QVector"

// qDeleteAll overload for QMap<K, V*> — deletes all map values
template<typename K, typename V>
inline void qDeleteAll(QMap<K, V*> &map) {
    for (auto it = map.begin(); it != map.end(); ++it) delete it.value();
}
template<typename K, typename V>
inline void qDeleteAll(const QMap<K, V*> &map) {
    for (auto it = map.begin(); it != map.end(); ++it) delete it.value();
}
